---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Simple Senior Fitness"
  description="Get in touch with Simple Senior Fitness. Questions, corrections, or feedback about our Japanese wellness articles are always welcome."
  keywords="contact simple senior fitness, contact us, japanese wellness questions"
  canonicalUrl="https://simpleseniorfitness.com/contact"
  author="Simple Senior Fitness"
>
  <main class="flex-1 w-full max-w-3xl mx-auto pb-12 px-6">
    <section class="pt-10 pb-8">
      <span class="inline-block py-1.5 px-3 rounded-full bg-emerald-100 text-accent-dark text-xs font-bold uppercase tracking-wider mb-4 border border-emerald-200">Contact</span>
      <h1 class="font-serif text-[1.4rem] lg:text-[2.25rem] font-medium text-text-main-light mb-6 leading-tight">
        Get in Touch
      </h1>
      <p class="text-lg lg:text-xl text-text-muted-light leading-relaxed">
        Questions about a specific technique? Spotted an error in an article? Have a suggestion for a Japanese wellness practice you'd like to see covered? We'd love to hear from you.
      </p>
    </section>

    <section class="mb-12">
      <div class="bg-white rounded-xl p-8 lg:p-10 shadow-sm border border-gray-200">
        <h2 class="font-serif text-xl lg:text-2xl font-bold text-text-main-light mb-4">Email</h2>
        <p class="text-base lg:text-lg text-text-muted-light leading-relaxed mb-6">
          The fastest way to reach us is by email. We read every message and reply to most within a few days.
        </p>
        <a
          href="mailto:smartareshopping@gmail.com"
          class="inline-flex items-center gap-2 bg-accent-dark hover:bg-emerald-800 text-white font-bold py-3 px-6 rounded-lg text-base transition-colors shadow-sm hover:shadow-md"
        >
          <span class="material-symbols-outlined" style="font-size: 20px;">mail</span>
          smartareshopping@gmail.com
        </a>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="font-serif text-xl lg:text-2xl font-medium text-text-main-light mb-4">What we cannot help with</h2>
      <p class="text-base text-text-muted-light leading-relaxed mb-3">
        Simple Senior Fitness is an independent educational site. We are not licensed medical professionals and we cannot give medical advice, diagnose conditions, or recommend treatments for specific health problems. If you have a medical concern, please contact a qualified healthcare provider.
      </p>
      <p class="text-base text-text-muted-light leading-relaxed">
        We also can't reply to commercial outreach (link-building requests, guest-post pitches, sponsored content). Those messages will not receive a response.
      </p>
    </section>

    <section class="mb-12">
      <h2 class="font-serif text-xl lg:text-2xl font-medium text-text-main-light mb-4">Corrections</h2>
      <p class="text-base text-text-muted-light leading-relaxed">
        If you spot a factual error, an out-of-date link, or a poorly attributed quotation, we want to know. Email us with the article title, the exact passage, and (if possible) a link to a reliable source. We appreciate the help and credit good-faith corrections quickly.
      </p>
    </section>
  </main>
</BaseLayout>
