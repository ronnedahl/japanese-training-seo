---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROBLEM_AREAS, articles } from '../data/articles.ts';

// Group each article under its primary area (problems[0]). Every article appears
// exactly once. Areas with no primary article are skipped.
const groups = PROBLEM_AREAS
  .map((area) => ({
    area,
    items: articles.filter((article) => article.problems[0] === area.id),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout
  title="All Practices: Browse Every Japanese Wellness Method"
  description="Browse all Japanese wellness practices on Simple Senior Fitness, grouped by what they help most: back, neck and shoulders, posture, mobility, stress, and breathing."
  keywords="japanese wellness practices, senior exercises list, all wellness methods, browse japanese practices, gentle exercises over 50"
  canonicalUrl="https://simpleseniorfitness.com/practices"
  author="Simple Senior Fitness"
>
  <div class="flex-1 w-full max-w-4xl mx-auto pb-16 px-6">
    <!-- Hero -->
    <section class="pt-10 pb-8">
      <span class="inline-block py-1.5 px-3 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-accent-dark dark:text-emerald-400 text-xs font-bold uppercase tracking-wider mb-4 border border-emerald-200 dark:border-emerald-800">All Practices</span>
      <h1 class="font-serif text-[1.5rem] lg:text-[2.25rem] font-medium text-text-main-light dark:text-text-main-dark mb-5 leading-tight">
        Browse every practice
      </h1>
      <p class="text-lg lg:text-xl text-text-muted-light dark:text-text-muted-dark leading-relaxed max-w-2xl">
        Every gentle Japanese wellness practice on the site, grouped by what it helps most. Not sure where to start? Try the
        <a href="/practice-finder" class="text-accent-dark dark:text-emerald-400 font-bold hover:underline">Practice Finder</a>
        for a quick recommendation.
      </p>
    </section>

    <!-- Grouped practice sections -->
    {groups.map((group) => (
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-5">
          <span class="material-symbols-outlined text-accent-dark dark:text-emerald-400" style="font-size: 26px;" aria-hidden="true">{group.area.icon}</span>
          <h2 class="font-serif text-lg lg:text-xl font-medium text-text-main-light dark:text-text-main-dark">{group.area.label}</h2>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {group.items.map((article) => (
            <a
              href={article.url}
              class="flex flex-col bg-white dark:bg-surface-dark rounded-xl p-6 border border-gray-200 dark:border-gray-700 shadow-sm hover:border-accent-light hover:shadow-md transition-all"
            >
              <h3 class="font-serif text-lg font-bold text-text-main-light dark:text-text-main-dark mb-2">{article.title}</h3>
              <p class="text-sm text-text-muted-light dark:text-text-muted-dark leading-relaxed mb-3 grow">{article.blurb}</p>
              <span class="inline-flex items-center gap-1 text-sm font-bold text-accent-dark dark:text-emerald-400">
                Read the guide
                <span class="material-symbols-outlined" style="font-size: 18px;" aria-hidden="true">arrow_forward</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
