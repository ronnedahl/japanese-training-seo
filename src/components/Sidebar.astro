              <div class="flex-1">
                <span class="block text-sm font-medium text-text-main-light dark:text-text-main-dark group-hover:text-accent-dark dark:group-hover:text-emerald-400 transition-colors">Do-In Self Massage</span>
                <span class="block text-xs text-text-muted-light dark:text-text-muted-dark">Acupressure Techniques</span>
