              <span class="flex items-center justify-center size-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 text-accent-dark dark:text-emerald-400 text-xs font-bold group-hover:bg-accent-dark group-hover:text-white transition-colors">11</span>
              <div class="flex-1">
