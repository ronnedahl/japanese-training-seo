---
// Consistent medical disclaimer box for article pages.
// The page-specific disclaimer text goes in the default slot.
---
<div class="bg-amber-50 rounded-2xl p-8 mt-8 border border-amber-200">
  <div class="flex items-start gap-4">
    <span class="material-symbols-outlined text-amber-600 text-3xl flex-shrink-0" aria-hidden="true">warning</span>
    <div>
      <h3 class="font-bold text-xl text-text-main-light mb-3">Medical Disclaimer</h3>
      <p class="text-base text-text-muted-light leading-relaxed">
        <slot />
      </p>
    </div>
  </div>
</div>
